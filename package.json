{
  "name": "saldo-real",
  "version": "0.3.2",
  "description": "PWA global de previsibilidade financeira e saldo seguro para renda variável.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "personal-finance",
    "financial-wellbeing",
    "cash-flow",
    "pwa",
    "nodejs",
    "sqlite"
  ],
  "author": "Henrique Sembla",
  "license": "MIT"
}
